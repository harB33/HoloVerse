<FilesMatch "^\.env(?:\..*)?$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[\s?]) [NC]
    RewriteRule ^index\.php$ home [R=308,L]

    RewriteCond %{THE_REQUEST} \s/+pages/([A-Za-z0-9_-]+)\.php(?:[\s?]) [NC]
    RewriteRule ^pages/([A-Za-z0-9_-]+)\.php$ $1 [R=308,L]

    RewriteCond %{THE_REQUEST} \s/+([A-Za-z0-9_-]+)\.php(?:[\s?]) [NC]
    RewriteCond %{DOCUMENT_ROOT}/pages/%1.php -f
    RewriteRule ^([A-Za-z0-9_-]+)\.php$ $1 [R=308,L]

    RewriteCond %{THE_REQUEST} \s/+Functions/([A-Za-z0-9_-]+)\.php(?:[\s?]) [NC]
    RewriteRule ^Functions/([A-Za-z0-9_-]+)\.php$ $1 [R=308,L,NC]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([A-Za-z0-9_-]+)/$ $1 [R=308,L]

    RewriteRule ^home/?$ index.php [L]
    RewriteRule ^purchase/orders/?$ pages/orders.php [L,QSA]
    RewriteRule ^flash_sale/?$ flash-sale [R=308,L]
    RewriteRule ^flash-sale/?$ pages/flash_sale.php [L,QSA]
    RewriteRule ^pre_order/?$ pre-order [R=308,L]
    RewriteRule ^pre-order/?$ pages/pre_order.php [L,QSA]

    RewriteRule ^product/([^/]+)/?$ pages/product.php?slug=$1 [L,QSA]
    RewriteRule ^talent-merch/([^/]+)/([^/]+)/?$ pages/talent-merch.php?talent_slug=$1&category_slug=$2 [L,QSA]
    RewriteRule ^talent-merch/([^/]+)/?$ pages/talent-merch.php?talent_slug=$1 [L,QSA]
    RewriteRule ^products/category/([0-9]+)/?$ pages/products.php?category=$1 [L,QSA]
    RewriteRule ^products/generation/([A-Za-z0-9_-]+)/category/([0-9]+)/?$ pages/products.php?generation=$1&category=$2 [L,QSA]
    RewriteRule ^products/([A-Za-z0-9_-]+)/category/([0-9]+)/?$ pages/products.php?generation=$1&category=$2 [L,QSA]
    RewriteRule ^products/category/([^/]+)/?$ pages/products.php?category_slug=$1 [L,QSA]
    RewriteRule ^products/generation/([A-Za-z0-9_-]+)/category/([^/]+)/?$ pages/products.php?generation=$1&category_slug=$2 [L,QSA]
    RewriteRule ^products/generation/([A-Za-z0-9_-]+)/?$ pages/products.php?generation=$1 [L,QSA]
    RewriteRule ^products/([A-Za-z0-9_-]+)/category/([^/]+)/?$ pages/products.php?generation=$1&category_slug=$2 [L,QSA]
    RewriteRule ^products/([A-Za-z0-9_-]+)/([A-Za-z0-9_-]+)/?$ pages/products.php?generation=$1&category_slug=$2 [L,QSA]
    RewriteRule ^products/([^/]+)/?$ pages/products.php?route_segment=$1 [L,QSA]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([A-Za-z0-9_-]+)/?$ pages/$1.php [L,QSA]
</IfModule>
